{
  "rules": [
    {
      "id": "rule-order-track",
      "name": "Order Tracking & Status",
      "intent": "order_status",
      "trigger_type": "keywords",
      "triggers": [
        "track",
        "order",
        "status",
        "where is my order",
        "shipping",
        "delivery update",
        "package",
        "tracking"
      ],
      "pattern": "(?:order|#|tracking)?\\s*([0-9]{4,8})",
      "action_type": "CHECK_ORDER",
      "db_table": "orders",
      "lookup_field": "order_id",
      "response_template": "📦 **Order #{{order_id}} Found!**\n\n• **Customer:** {{customer_name}}\n• **Status:** {{status}}\n• **Carrier:** {{carrier}}\n• **Tracking Number:** `{{tracking_code}}`\n• **Estimated Delivery:** {{estimated_delivery}}\n• **Total:** ${{total_price}}\n\n**Items Ordered:**\n{{items_list}}\n\nNeed to change shipping address or report an issue?",
      "fallback_template": "⚠️ **Order Not Found in Database**\n\nWe checked the store database but could not find an order matching \"**{{query}}**\".\n\n💡 **Tips:**\n• Enter your 4-digit order number (e.g. **#1042** or **1043**)\n• Or enter the email address used at checkout.",
      "prompt_missing": "🔍 **Look up your Order:**\n\nPlease enter your **Order Number** (e.g. **#1042**) or the **Email Address** you used at checkout.",
      "quick_replies": [
        "Try #1042",
        "Try #1043",
        "Speak with Agent",
        "Return Policy"
      ],
      "priority": 1,
      "is_active": true
    },
    {
      "id": "rule-return-refund",
      "name": "Returns & Refund Policy",
      "intent": "return_policy",
      "trigger_type": "keywords",
      "triggers": [
        "return",
        "refund",
        "exchange",
        "money back",
        "send back",
        "cancel order",
        "return item"
      ],
      "action_type": "DIRECT_RESPONSE",
      "response_template": "🔄 **Return & Refund Policy:**\n\n• **Window:** 30 days from delivery date.\n• **Condition:** Items must be in original condition with tags and packaging intact.\n• **Refund Processing:** Issued back to your original payment method within 3–5 business days of receipt.\n• **Return Fee:** Free prepaid return label for all domestic orders!\n\nTo initiate a return right now, please provide your **Order #** or type **\"human agent\"**.",
      "quick_replies": [
        "Start a Return",
        "Track Order",
        "Speak with Agent"
      ],
      "priority": 2,
      "is_active": true
    },
    {
      "id": "rule-product-stock",
      "name": "Product Stock & Price Check",
      "intent": "product_lookup",
      "trigger_type": "keywords",
      "triggers": [
        "stock",
        "price",
        "cost",
        "available",
        "inventory",
        "buy",
        "desk mat",
        "keycaps",
        "light bar",
        "cable organizer"
      ],
      "action_type": "CHECK_PRODUCT",
      "db_table": "products",
      "lookup_field": "sku_or_title",
      "response_template": "🏷️ **Product In Database:**\n\n• **Product:** {{title}}\n• **Price:** ${{price}}\n• **Availability:** {{stock_status}}\n• **Warehouse Qty:** {{stock_qty}} units remaining\n• **SKU:** `{{sku}}`\n\nWould you like a checkout link or have questions about specs?",
      "fallback_template": "🔍 We checked our current inventory catalog but couldn't find an exact match for \"{{query}}\".\n\nHere are some of our popular available items:\n• Minimalist Matte Black Desk Mat ($39.00)\n• Stealth Black PBT Keycaps ($69.00)\n• Ultra-slim Monitor Light Bar ($89.00)",
      "quick_replies": [
        "Check Desk Mat",
        "Check Keycaps",
        "Check Promo Codes"
      ],
      "priority": 3,
      "is_active": true
    },
    {
      "id": "rule-discounts",
      "name": "Discounts & Coupon Codes",
      "intent": "promotions",
      "trigger_type": "keywords",
      "triggers": [
        "discount",
        "coupon",
        "promo",
        "code",
        "voucher",
        "sale",
        "deal",
        "offer"
      ],
      "action_type": "CHECK_PROMOTION",
      "db_table": "promotions",
      "response_template": "🎉 **Active Store Coupons & Deals:**\n\n{{promotions_list}}\n\n👉 Apply these codes at checkout on your Shopify or WordPress store.",
      "quick_replies": [
        "Apply WELCOME10",
        "Browse Products",
        "Track Order"
      ],
      "priority": 4,
      "is_active": true
    },
    {
      "id": "rule-human-escalate",
      "name": "Live Agent Escalation",
      "intent": "human_takeover",
      "trigger_type": "keywords",
      "triggers": [
        "human",
        "agent",
        "person",
        "representative",
        "support team",
        "talk to someone",
        "operator",
        "real person",
        "help me"
      ],
      "action_type": "ESCALATE_HUMAN",
      "response_template": "👨‍💼 **Routing you to a Live Support Agent...**\n\nYour conversation has been flagged in our **Unified Support Desk**.\n\n• **Queue Status:** Next in line\n• **Average Response Time:** ~2 minutes\n• **Agent Notification:** Sent\n\nPlease describe your request below and an agent will join this thread.",
      "quick_replies": [
        "Never mind, check order",
        "Store Hours"
      ],
      "priority": 5,
      "is_active": true
    },
    {
      "id": "rule-business-hours",
      "name": "Store Hours & Contact",
      "intent": "business_hours",
      "trigger_type": "keywords",
      "triggers": [
        "hours",
        "open",
        "timing",
        "phone",
        "contact info",
        "email address",
        "location",
        "where are you"
      ],
      "action_type": "DIRECT_RESPONSE",
      "response_template": "🕒 **Store Hours & Contact Info:**\n\n• **Online Store:** Open 24/7/365\n• **Support Desk:** Monday – Friday, 8:00 AM – 7:00 PM EST\n• **Email:** support@yourstore.com\n• **Fulfillment Hub:** Austin, Texas, USA\n\nAll orders ship Monday through Friday before 3:00 PM EST.",
      "quick_replies": [
        "Track Order",
        "Return Policy",
        "Speak with Agent"
      ],
      "priority": 6,
      "is_active": true
    }
  ],
